{
  "name": "@cf-tamac/client",
  "version": "0.1.0",
  "private": true,
  "license": "MPL-2.0",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:worker": "opennextjs-cloudflare build",
    "preview": "pnpm build:worker && wrangler dev --config wrangler.toml",
    "deploy": "pnpm build:worker && wrangler deploy --config wrangler.toml",
    "db:migrate:local": "wrangler d1 migrations apply cf-tamac-client-db --local --config wrangler.toml",
    "db:migrate:remote": "wrangler d1 migrations apply cf-tamac-client-db --remote --config wrangler.toml",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.12.0",
    "@connectrpc/connect": "^2.1.2",
    "@connectrpc/connect-web": "^2.1.2",
    "@hookform/resolvers": "^5.4.0",
    "@radix-ui/react-dialog": "^1.1.17",
    "@radix-ui/react-slot": "^1.3.0",
    "@tanstack/react-query": "5.101.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.21.0",
    "next": "^16.2.9",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-hook-form": "^7.79.0",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260613.1",
    "@opennextjs/cloudflare": "^1.19.11",
    "@types/node": "^25.0.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.5.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "postcss": "^8.5.15",
    "tailwindcss": "3.4.17",
    "typescript": "^5.9.3",
    "vitest": "^4.1.8",
    "wrangler": "^4.57.0"
  }
}
