{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "../..",
    "outDir": "dist",
    "jsx": "preserve",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["@cloudflare/workers-types", "node"]
  },
  "include": [
    "app/**/*.ts",
    "app/**/*.tsx",
    "src/**/*.ts",
    "src/**/*.tsx",
    "next.config.ts",
    "open-next.config.ts",
    "vitest.config.ts",
    "tailwind.config.ts",
    "postcss.config.mjs"
  ],
  "exclude": [".next", ".open-next", "dist", "node_modules"]
}
