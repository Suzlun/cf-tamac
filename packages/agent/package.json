{
  "name": "@cf-tamac/agent",
  "version": "0.1.0",
  "private": true,
  "license": "MPL-2.0",
  "type": "module",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "dev": "wrangler dev --config wrangler.toml",
    "deploy": "wrangler deploy --config wrangler.toml",
    "build": "tsc -p tsconfig.json --noEmit",
    "check": "pnpm build",
    "test": "vitest run --passWithNoTests",
    "gen:proto": "tsp compile src/typespec",
    "lint:proto": "buf lint",
    "breaking:proto": "buf breaking --against proto",
    "gen:rpc": "pnpm run lint:proto && pnpm run breaking:proto && buf generate"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.12.0",
    "@connectrpc/connect": "^2.1.2",
    "agents": "^0.16.2",
    "drizzle-orm": "^0.45.2",
    "jose": "^6.2.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@bufbuild/buf": "^1.71.0",
    "@bufbuild/protoc-gen-es": "^2.12.0",
    "@cloudflare/workers-types": "^4.20260613.1",
    "@typespec/compiler": "^1.13.0",
    "@typespec/protobuf": "^0.83.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.8",
    "wrangler": "^4.57.0"
  }
}
