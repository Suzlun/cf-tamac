{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "ignoreDeprecations": "5.0",
    "rootDir": ".",
    "baseUrl": ".",
    "paths": {
      "@cf-tamac-frontend/app/*": ["packages/frontend/app/src/*"],
      "@cf-tamac-frontend/domain/*": ["packages/frontend/domain/src/*"],
      "@cf-tamac-frontend/api/*": ["packages/frontend/api/src/*"],
      "@cf-tamac-frontend/api": ["packages/frontend/api/src/index.ts"],
      "@cf-tamac-frontend/ui/*": ["packages/frontend/ui/src/*"],
      "@cf-tamac-frontend/ui": ["packages/frontend/ui/src/index.ts"],
      "@cf-tamac-backend/types/*": ["packages/backend/types/src/*"],
      "@cf-tamac-backend/types": ["packages/backend/types/src/index.ts"],
      "@cf-tamac-backend/domain/*": ["packages/backend/domain/src/*"],
      "@cf-tamac-backend/domain": ["packages/backend/domain/src/index.ts"],
      "@cf-tamac-backend/usecases/*": ["packages/backend/usecases/src/*"],
      "@cf-tamac-backend/usecases": ["packages/backend/usecases/src/index.ts"],
      "@cf-tamac-backend/http/*": ["packages/backend/http/src/*"],
      "@cf-tamac-backend/http": ["packages/backend/http/src/index.ts"],
      "@cf-tamac-backend/persistence/*": ["packages/backend/persistence/src/*"],
      "@cf-tamac-backend/persistence": ["packages/backend/persistence/src/index.ts"],
      "@cf-tamac-backend/app/*": ["packages/backend/app/src/*"],
      "@cf-tamac-backend/app": ["packages/backend/app/src/index.ts"],
      "@cf-tamac-backend/entry/*": ["packages/backend/entry/src/*"],
      "@cf-tamac-backend/entry": ["packages/backend/entry/src/index.ts"],
      "@cf-tamac-backend/drizzle/*": ["packages/backend/drizzle/src/*"],
      "@cf-tamac-backend/drizzle": ["packages/backend/drizzle/src/index.ts"]
    },
    "resolveJsonModule": true,
    "allowJs": true,
    "checkJs": false,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true
  },
  "exclude": ["node_modules", "dist", "build", ".wrangler"]
}
