{
  "name": "cf-tamac",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Agent Service and Management Client foundation for Cloudflare Workers",
  "imports": {
    "#openspec/change-artifacts": "./scripts/openspec/change-artifacts.mjs",
    "#openspec/guard-test-fixture": "./scripts/openspec/guard-test-fixture.mjs"
  },
  "license": "MPL-2.0",
  "packageManager": "pnpm@11.16.0",
  "engines": {
    "node": ">=24.12.0"
  },
  "scripts": {
    "dev:agent": "pnpm --filter @cf-tamac/agent --if-present dev",
    "dev:client": "pnpm --filter @cf-tamac/client --if-present dev",
    "build:agent": "pnpm --filter @cf-tamac/agent --if-present build",
    "build:sdk": "pnpm --filter @cf-tamac/sdk --if-present build",
    "build:client": "pnpm --filter @cf-tamac/client --if-present build",
    "build": "pnpm build:agent && pnpm build:sdk && pnpm build:client",
    "check:agent": "pnpm --filter @cf-tamac/agent --if-present check",
    "check:client": "pnpm --filter @cf-tamac/client --if-present check",
    "check": "pnpm --filter \"./packages/**\" check",
    "gen:agent:proto": "pnpm --filter @cf-tamac/agent --if-present gen:proto",
    "gen:agent:rpc": "pnpm --filter @cf-tamac/agent --if-present gen:rpc",
    "gen:openspec": "node scripts/openspec/generate-opencode.mjs",
    "gen": "pnpm gen:agent:proto && pnpm gen:agent:rpc",
    "check:codegen": "node scripts/codegen/check-generated-output-stability.mjs",
    "gen:deploy-artifacts": "node scripts/deploy/generate-deploy-artifacts.mjs",
    "check:deploy-artifacts": "node scripts/deploy/generate-deploy-artifacts.mjs --out .deploy --production-rate-limit-namespace-id 1001 --staging-rate-limit-namespace-id 1002",
    "deploy:agent": "pnpm --filter @cf-tamac/agent --if-present deploy",
    "deploy:client": "pnpm --filter @cf-tamac/client --if-present deploy",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run && pnpm test:openspec-rules",
    "test:coverage": "vitest run --coverage",
    "test:agent": "pnpm --filter @cf-tamac/agent --if-present test",
    "test:client": "pnpm --filter @cf-tamac/client --if-present test",
    "test:governance": "vitest run --project governance && pnpm test:openspec-rules",
    "test:openspec-rules": "node --test scripts/openspec/*.test.mjs",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "lint": "pnpm lint:eslint && pnpm lint:openspec && pnpm lint:governance && pnpm lint:supply-chain",
    "lint:eslint": "eslint .",
    "lint:openspec": "pnpm exec openspec schema validate behavior-change && pnpm exec openspec schema validate architecture-change && pnpm exec openspec validate --all --strict && pnpm test:openspec-rules && node scripts/openspec/verify-change-proposal.mjs && node scripts/openspec/verify-change-reuse-decisions.mjs && node scripts/openspec/verify-scenario-coverage.mjs && node scripts/openspec/verify-change-task-scope.mjs",
    "lint:governance": "node scripts/governance/verify-agent-surface.mjs && node scripts/governance/verify-package-boundaries.mjs",
    "lint:supply-chain": "node scripts/security/verify-pnpm-supply-chain.mjs",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.3.0",
    "@commitlint/config-conventional": "^20.3.0",
    "@eslint/eslintrc": "^3.3.3",
    "@eslint/js": "^9.39.2",
    "@fission-ai/openspec": "1.8.0",
    "@playwright/test": "^1.57.0",
    "@types/node": "^25.0.3",
    "@vitest/ui": "^4.1.8",
    "eslint": "^9.39.2",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-boundaries": "^5.3.1",
    "eslint-plugin-eslint-comments": "^3.2.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-security": "^3.0.1",
    "eslint-plugin-sonarjs": "^3.0.5",
    "eslint-plugin-unicorn": "^62.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "playwright": "^1.57.0",
    "prettier": "^3.7.4",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.52.0",
    "typescript-language-server": "^5.3.0",
    "vitest": "^4.1.8",
    "wrangler": "^4.57.0"
  }
}
