{
  "name": "Selected-Agent Threads",
  "viewport": { "width": 1280, "height": 800 },
  "root": {
    "name": "App shell",
    "direction": "vertical",
    "children": [
      { "name": "Skip link", "type": "link", "height": 32 },
      {
        "name": "Body",
        "direction": "horizontal",
        "grow": true,
        "children": [
          {
            "name": "Side menu (agent-selected, Threads active)",
            "direction": "vertical",
            "width": 256,
            "padding": 16,
            "gap": 12,
            "children": [
              {
                "name": "Brand mark + product name",
                "direction": "horizontal",
                "gap": 8,
                "align": "center",
                "height": 32,
                "children": [
                  { "name": "Logo", "type": "icon", "width": 28, "height": 28 },
                  { "name": "Product title", "type": "text", "variant": "heading", "height": 24 }
                ]
              },
              {
                "name": "Global nav group",
                "direction": "vertical",
                "gap": 4,
                "children": [
                  { "name": "Agents", "type": "link", "height": 36 },
                  { "name": "Global Settings", "type": "link", "height": 36 }
                ]
              },
              { "name": "Separator", "type": "divider" },
              {
                "name": "Agent identity header",
                "direction": "horizontal",
                "gap": 8,
                "align": "center",
                "children": [
                  { "name": "Agent avatar", "type": "icon", "width": 32, "height": 32 },
                  {
                    "name": "Display name + Agent ID",
                    "direction": "vertical",
                    "gap": 2,
                    "children": [
                      { "name": "Display name", "type": "text", "height": 18 },
                      {
                        "name": "Agent ID (mono)",
                        "type": "text",
                        "variant": "caption",
                        "height": 14
                      }
                    ]
                  }
                ]
              },
              {
                "name": "Agent-scoped navigation",
                "direction": "vertical",
                "gap": 2,
                "children": [
                  { "name": "Overview", "type": "link", "height": 34 },
                  { "name": "Threads (active)", "type": "link", "height": 34 },
                  { "name": "Events", "type": "link", "height": 34 },
                  { "name": "Runs", "type": "link", "height": 34 },
                  { "name": "Schedules", "type": "link", "height": 34 },
                  { "name": "Integrations", "type": "link", "height": 34 },
                  { "name": "Settings", "type": "link", "height": 34 }
                ]
              }
            ]
          },
          {
            "name": "Main content (list/detail composition)",
            "direction": "vertical",
            "grow": true,
            "padding": 32,
            "gap": 20,
            "children": [
              {
                "name": "Page header",
                "direction": "horizontal",
                "justify": "space-between",
                "align": "center",
                "children": [
                  {
                    "name": "Breadcrumb: Agents / [Agent] / Threads",
                    "type": "link",
                    "height": 20
                  },
                  { "name": "Refresh (server read)", "type": "button", "height": 36 }
                ]
              },
              {
                "name": "List/detail split",
                "direction": "horizontal",
                "gap": 20,
                "grow": true,
                "children": [
                  {
                    "name": "Thread list (left, w-80)",
                    "direction": "vertical",
                    "gap": 10,
                    "width": 320,
                    "children": [
                      { "name": "Filter/scope input", "type": "input", "grow": true, "height": 36 },
                      { "name": "Thread item 1 (selected)", "type": "card", "height": 88 },
                      { "name": "Thread item 2", "type": "card", "height": 88 },
                      { "name": "Thread item 3", "type": "card", "height": 88 },
                      { "name": "List pagination", "type": "button", "height": 32 }
                    ]
                  },
                  {
                    "name": "Thread detail (right, grows)",
                    "direction": "vertical",
                    "gap": 16,
                    "grow": true,
                    "children": [
                      {
                        "name": "Detail header: thread key, state, latest Event/Run",
                        "type": "card",
                        "height": 110
                      },
                      {
                        "name": "Event/Run timeline (causal links)",
                        "type": "card",
                        "grow": true,
                        "height": 200
                      },
                      {
                        "name": "Contextual Compaction history (folded-in, no top-level Compactions nav)",
                        "direction": "vertical",
                        "gap": 10,
                        "children": [
                          {
                            "name": "Section label: Compaction history",
                            "type": "text",
                            "variant": "heading",
                            "height": 22
                          },
                          {
                            "name": "Latest Handoff + Memory version",
                            "type": "card",
                            "height": 80
                          },
                          {
                            "name": "History references + rebase state",
                            "type": "card",
                            "height": 80
                          }
                        ]
                      }
                    ]
                  }
                ]
              }
            ]
          }
        ]
      }
    ]
  }
}
