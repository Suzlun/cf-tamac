{
  "name": "Agents entry (no Agent selected)",
  "viewport": { "width": 1280, "height": 800 },
  "root": {
    "name": "App shell",
    "direction": "vertical",
    "children": [
      {
        "name": "Skip link (visually hidden until focused)",
        "type": "link",
        "height": 32
      },
      {
        "name": "Body",
        "direction": "horizontal",
        "grow": true,
        "children": [
          {
            "name": "Side menu (persistent, w-64)",
            "direction": "vertical",
            "width": 256,
            "padding": 16,
            "gap": 16,
            "children": [
              {
                "name": "Brand mark + product name",
                "direction": "horizontal",
                "gap": 8,
                "align": "center",
                "height": 32,
                "children": [
                  { "name": "Logo", "type": "icon", "width": 28, "height": 28 },
                  { "name": "Product title", "type": "text", "variant": "heading", "height": 24 }
                ]
              },
              {
                "name": "Global navigation",
                "direction": "vertical",
                "gap": 4,
                "children": [
                  {
                    "name": "Global nav group label",
                    "type": "text",
                    "variant": "caption",
                    "height": 16
                  },
                  { "name": "Agents (active)", "type": "link", "height": 36 },
                  { "name": "Global Settings", "type": "link", "height": 36 }
                ]
              },
              {
                "name": "Selected-Agent navigation (hidden until an Agent is chosen)",
                "type": "text",
                "variant": "caption",
                "height": 16
              },
              {
                "name": "Spacer",
                "grow": true
              },
              {
                "name": "Sidebar footer (build/version, user)",
                "direction": "vertical",
                "gap": 4,
                "children": [
                  {
                    "name": "Signed-in operator",
                    "type": "text",
                    "variant": "caption",
                    "height": 16
                  },
                  { "name": "Build version", "type": "text", "variant": "caption", "height": 16 }
                ]
              }
            ]
          },
          {
            "name": "Main content",
            "direction": "vertical",
            "grow": true,
            "padding": 32,
            "gap": 24,
            "children": [
              {
                "name": "Page header",
                "direction": "horizontal",
                "justify": "space-between",
                "align": "center",
                "children": [
                  {
                    "name": "Title block",
                    "direction": "vertical",
                    "gap": 4,
                    "children": [
                      { "name": "Breadcrumb: Agents", "type": "link", "height": 20 },
                      { "name": "Agents", "type": "text", "variant": "display", "height": 40 },
                      {
                        "name": "Lead: managed Agents in this Client; Agent state lives in the Agent Worker.",
                        "type": "text",
                        "height": 20
                      }
                    ]
                  },
                  { "name": "New Agent (primary action)", "type": "button", "height": 40 }
                ]
              },
              {
                "name": "Filters + sort row",
                "direction": "horizontal",
                "gap": 12,
                "align": "center",
                "children": [
                  {
                    "name": "Search Agents",
                    "type": "input",
                    "grow": true,
                    "maxWidth": 360,
                    "height": 36
                  },
                  { "name": "Sort select", "type": "input", "height": 36 },
                  { "name": "Pinned first toggle", "type": "button", "height": 36 }
                ]
              },
              {
                "name": "Agent list (card/list composition, NOT a table)",
                "direction": "vertical",
                "gap": 12,
                "grow": true,
                "children": [
                  {
                    "name": "Agent row 1 (pinned)",
                    "type": "card",
                    "height": 96,
                    "children": [
                      {
                        "name": "Row content",
                        "direction": "horizontal",
                        "gap": 16,
                        "align": "center",
                        "children": [
                          { "name": "Pin indicator", "type": "icon", "width": 20, "height": 20 },
                          {
                            "name": "Display name + Agent ID",
                            "direction": "vertical",
                            "gap": 2,
                            "grow": true,
                            "children": [
                              { "name": "Display name", "type": "text", "height": 20 },
                              {
                                "name": "Agent ID (mono)",
                                "type": "text",
                                "variant": "caption",
                                "height": 16
                              }
                            ]
                          },
                          { "name": "Credential status badge", "type": "button", "height": 24 },
                          {
                            "name": "Last opened",
                            "type": "text",
                            "variant": "caption",
                            "height": 16
                          },
                          { "name": "Open (chevron)", "type": "button", "height": 36 }
                        ]
                      }
                    ]
                  },
                  {
                    "name": "Agent row 2",
                    "type": "card",
                    "height": 96
                  },
                  {
                    "name": "Agent row 3",
                    "type": "card",
                    "height": 96
                  }
                ]
              },
              {
                "name": "Pagination bar",
                "direction": "horizontal",
                "justify": "space-between",
                "align": "center",
                "children": [
                  { "name": "Result count", "type": "text", "variant": "caption", "height": 16 },
                  { "name": "Page controls", "type": "button", "height": 36 }
                ]
              }
            ]
          }
        ]
      }
    ]
  }
}
