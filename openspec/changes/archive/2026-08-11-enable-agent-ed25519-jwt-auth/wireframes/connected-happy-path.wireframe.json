{
  "name": "Connected Happy Path",
  "viewport": { "width": 1200, "height": 760 },
  "root": {
    "name": "Management Shell",
    "direction": "horizontal",
    "children": [
      {
        "name": "Left Sidebar With Connected Agent",
        "width": 256,
        "direction": "vertical",
        "padding": 16,
        "gap": 12,
        "children": [
          { "name": "cf-tamac Management", "type": "text", "variant": "heading", "height": 40 },
          { "name": "Agents", "type": "link", "height": 40 },
          { "name": "Global Settings", "type": "link", "height": 40 },
          { "name": "Selected Agent", "type": "text", "variant": "caption", "height": 24 },
          { "name": "Overview", "type": "link", "height": 40 },
          { "name": "Threads", "type": "link", "height": 40 },
          { "name": "Events", "type": "link", "height": 40 },
          { "name": "Runs", "type": "link", "height": 40 },
          { "name": "Schedules", "type": "link", "height": 40 },
          { "name": "Integrations", "type": "link", "height": 40 },
          { "name": "Settings", "type": "link", "height": 40 }
        ]
      },
      {
        "name": "Connected Agent Main",
        "direction": "vertical",
        "grow": true,
        "padding": 32,
        "gap": 24,
        "children": [
          {
            "name": "Connected Status Header",
            "direction": "horizontal",
            "justify": "space-between",
            "gap": 24,
            "children": [
              {
                "name": "Header Copy",
                "direction": "vertical",
                "gap": 8,
                "grow": true,
                "children": [
                  {
                    "name": "Agent / Overview",
                    "type": "text",
                    "variant": "caption",
                    "height": 20
                  },
                  {
                    "name": "Overview shows live Agent data",
                    "type": "text",
                    "variant": "display",
                    "height": 52
                  },
                  {
                    "name": "Global signing key selected, trust config applied to Agent Worker, and Health Check passed.",
                    "type": "text",
                    "height": 48
                  }
                ]
              },
              { "name": "Run Health Check Again", "type": "button", "height": 44 }
            ]
          },
          {
            "name": "Connection Prerequisite Badges",
            "direction": "horizontal",
            "gap": 16,
            "children": [
              {
                "name": "Global signing key exists and selected",
                "type": "card",
                "grow": true,
                "height": 72
              },
              {
                "name": "Trust config exported and applied",
                "type": "card",
                "grow": true,
                "height": 72
              },
              { "name": "Health verification passed", "type": "card", "grow": true, "height": 72 }
            ]
          },
          {
            "name": "Connection Summary Cards",
            "direction": "horizontal",
            "gap": 16,
            "children": [
              { "name": "Serving status", "type": "card", "grow": true, "height": 112 },
              { "name": "Issuer kid fingerprint", "type": "card", "grow": true, "height": 112 },
              { "name": "Scopes accepted", "type": "card", "grow": true, "height": 112 }
            ]
          },
          {
            "name": "Selected Agent Data Sections",
            "direction": "horizontal",
            "gap": 16,
            "children": [
              { "name": "Profile and lifecycle", "type": "card", "grow": true, "height": 132 },
              { "name": "Latest thread and memory", "type": "card", "grow": true, "height": 132 },
              { "name": "Latest run and tool status", "type": "card", "grow": true, "height": 132 }
            ]
          },
          {
            "name": "Data Route Readiness",
            "type": "table",
            "columns": [
              { "name": "Route", "grow": true },
              { "name": "Source", "grow": true },
              { "name": "Fallback", "width": 132 },
              { "name": "Verified", "width": 132 }
            ],
            "rows": 7
          }
        ]
      }
    ]
  }
}
