{
  "name": "Selected-Agent Events",
  "viewport": { "width": 1280, "height": 800 },
  "root": {
    "name": "App shell",
    "direction": "vertical",
    "children": [
      { "name": "Skip link", "type": "link", "height": 32 },
      {
        "name": "Body",
        "direction": "horizontal",
        "grow": true,
        "children": [
          {
            "name": "Side menu (agent-selected, Events active)",
            "direction": "vertical",
            "width": 256,
            "padding": 16,
            "gap": 12,
            "children": [
              {
                "name": "Brand mark + product name",
                "direction": "horizontal",
                "gap": 8,
                "align": "center",
                "height": 32,
                "children": [
                  { "name": "Logo", "type": "icon", "width": 28, "height": 28 },
                  { "name": "Product title", "type": "text", "variant": "heading", "height": 24 }
                ]
              },
              {
                "name": "Global nav group",
                "direction": "vertical",
                "gap": 4,
                "children": [
                  { "name": "Agents", "type": "link", "height": 36 },
                  { "name": "Global Settings", "type": "link", "height": 36 }
                ]
              },
              { "name": "Separator", "type": "divider" },
              {
                "name": "Agent identity header",
                "direction": "horizontal",
                "gap": 8,
                "align": "center",
                "children": [
                  { "name": "Agent avatar", "type": "icon", "width": 32, "height": 32 },
                  {
                    "name": "Display name + Agent ID",
                    "direction": "vertical",
                    "gap": 2,
                    "children": [
                      { "name": "Display name", "type": "text", "height": 18 },
                      {
                        "name": "Agent ID (mono)",
                        "type": "text",
                        "variant": "caption",
                        "height": 14
                      }
                    ]
                  }
                ]
              },
              {
                "name": "Agent-scoped navigation",
                "direction": "vertical",
                "gap": 2,
                "children": [
                  { "name": "Overview", "type": "link", "height": 34 },
                  { "name": "Threads", "type": "link", "height": 34 },
                  { "name": "Events (active)", "type": "link", "height": 34 },
                  { "name": "Runs", "type": "link", "height": 34 },
                  { "name": "Schedules", "type": "link", "height": 34 },
                  { "name": "Integrations", "type": "link", "height": 34 },
                  { "name": "Settings", "type": "link", "height": 34 }
                ]
              }
            ]
          },
          {
            "name": "Main content",
            "direction": "vertical",
            "grow": true,
            "padding": 32,
            "gap": 20,
            "children": [
              {
                "name": "Page header",
                "direction": "horizontal",
                "justify": "space-between",
                "align": "center",
                "children": [
                  { "name": "Breadcrumb: Agents / [Agent] / Events", "type": "link", "height": 20 },
                  {
                    "name": "Context filters (sequence, type, source, thread scope)",
                    "direction": "horizontal",
                    "gap": 8,
                    "children": [
                      { "name": "Type select", "type": "input", "height": 36 },
                      { "name": "Thread scope select", "type": "input", "height": 36 }
                    ]
                  }
                ]
              },
              {
                "name": "Events timeline (card/list composition)",
                "direction": "vertical",
                "gap": 10,
                "grow": true,
                "children": [
                  {
                    "name": "Event item 1 (sequence, type, source, state)",
                    "type": "card",
                    "height": 76
                  },
                  { "name": "Event item 2", "type": "card", "height": 76 },
                  {
                    "name": "Event item 3 (tool-event, expands to ToolInvocation context)",
                    "type": "card",
                    "height": 76
                  },
                  {
                    "name": "Event item 4 (compaction-event, expands to Compaction context)",
                    "type": "card",
                    "height": 76
                  }
                ]
              },
              {
                "name": "Event detail (Sheet/Drawer on narrow widths)",
                "direction": "vertical",
                "gap": 12,
                "children": [
                  { "name": "Snapshot + causal link detail", "type": "card", "height": 120 },
                  {
                    "name": "Contextual Tool / Compaction detail (folded-in)",
                    "direction": "horizontal",
                    "gap": 12,
                    "children": [
                      {
                        "name": "ToolInvocation context (if tool-event)",
                        "type": "card",
                        "grow": true,
                        "height": 96
                      },
                      {
                        "name": "Compaction context (if compaction-event)",
                        "type": "card",
                        "grow": true,
                        "height": 96
                      }
                    ]
                  }
                ]
              },
              { "name": "Pagination + scope-preserving filter bar", "type": "button", "height": 36 }
            ]
          }
        ]
      }
    ]
  }
}
