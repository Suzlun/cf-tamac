{
  "name": "Selected-Agent Settings",
  "viewport": { "width": 1280, "height": 800 },
  "root": {
    "name": "App shell",
    "direction": "vertical",
    "children": [
      { "name": "Skip link", "type": "link", "height": 32 },
      {
        "name": "Body",
        "direction": "horizontal",
        "grow": true,
        "children": [
          {
            "name": "Side menu (agent-selected, Settings active)",
            "direction": "vertical",
            "width": 256,
            "padding": 16,
            "gap": 12,
            "children": [
              {
                "name": "Brand mark + product name",
                "direction": "horizontal",
                "gap": 8,
                "align": "center",
                "height": 32,
                "children": [
                  { "name": "Logo", "type": "icon", "width": 28, "height": 28 },
                  { "name": "Product title", "type": "text", "variant": "heading", "height": 24 }
                ]
              },
              {
                "name": "Global nav group",
                "direction": "vertical",
                "gap": 4,
                "children": [
                  { "name": "Agents", "type": "link", "height": 36 },
                  { "name": "Global Settings", "type": "link", "height": 36 }
                ]
              },
              { "name": "Separator", "type": "divider" },
              {
                "name": "Agent identity header",
                "direction": "horizontal",
                "gap": 8,
                "align": "center",
                "children": [
                  { "name": "Agent avatar", "type": "icon", "width": 32, "height": 32 },
                  {
                    "name": "Display name + Agent ID",
                    "direction": "vertical",
                    "gap": 2,
                    "children": [
                      { "name": "Display name", "type": "text", "height": 18 },
                      {
                        "name": "Agent ID (mono)",
                        "type": "text",
                        "variant": "caption",
                        "height": 14
                      }
                    ]
                  }
                ]
              },
              {
                "name": "Agent-scoped navigation",
                "direction": "vertical",
                "gap": 2,
                "children": [
                  { "name": "Overview", "type": "link", "height": 34 },
                  { "name": "Threads", "type": "link", "height": 34 },
                  { "name": "Events", "type": "link", "height": 34 },
                  { "name": "Runs", "type": "link", "height": 34 },
                  { "name": "Schedules", "type": "link", "height": 34 },
                  { "name": "Integrations", "type": "link", "height": 34 },
                  { "name": "Settings (active)", "type": "link", "height": 34 }
                ]
              }
            ]
          },
          {
            "name": "Main content (in-page section nav via Tabs/ScrollArea)",
            "direction": "vertical",
            "grow": true,
            "padding": 32,
            "gap": 20,
            "children": [
              {
                "name": "Page header",
                "direction": "vertical",
                "gap": 4,
                "children": [
                  {
                    "name": "Breadcrumb: Agents / [Agent] / Settings",
                    "type": "link",
                    "height": 20
                  },
                  { "name": "Agent settings", "type": "text", "variant": "display", "height": 32 }
                ]
              },
              {
                "name": "Settings section tabs (Configuration / Model policy / Credentials / Tools catalog)",
                "direction": "horizontal",
                "gap": 8,
                "children": [
                  { "name": "Configuration (active)", "type": "button", "height": 36 },
                  { "name": "Model policy", "type": "button", "height": 36 },
                  { "name": "Credentials", "type": "button", "height": 36 },
                  { "name": "Tools catalog", "type": "button", "height": 36 }
                ]
              },
              {
                "name": "Configuration section",
                "direction": "vertical",
                "gap": 14,
                "children": [
                  {
                    "name": "Config form (display name, RPC origin, model policy ref)",
                    "type": "card",
                    "height": 200
                  },
                  {
                    "name": "Save config (explicit, server-side UpdateConfig)",
                    "type": "button",
                    "height": 40
                  }
                ]
              },
              {
                "name": "Contextual Tools catalog (folded-in, no top-level Tools nav)",
                "direction": "vertical",
                "gap": 12,
                "children": [
                  {
                    "name": "Section label: Tool catalog & approval",
                    "type": "text",
                    "variant": "heading",
                    "height": 22
                  },
                  {
                    "name": "Tool definition + installation ownership + approval state",
                    "type": "card",
                    "height": 110
                  },
                  {
                    "name": "Pending approval actions (explicit, acting user context)",
                    "type": "button",
                    "height": 40
                  }
                ]
              }
            ]
          }
        ]
      }
    ]
  }
}
