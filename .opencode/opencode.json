{
  "$schema": "https://opencode.ai/config.json",
  "subagent_depth": 5,
  "lsp": {
    "typescript": {
      "command": ["pnpm", "exec", "typescript-language-server", "--stdio"],
      "extensions": [".ts", ".tsx", ".mts", ".cts", ".js", ".jsx", ".mjs", ".cjs"]
    }
  },
  "mcp": {
    "agent-browser": {
      "type": "local",
      "command": ["agent-browser", "mcp", "--tools", "core,network,react,tabs"],
      "cwd": ".",
      "enabled": true,
      "timeout": 60000,
      "environment": {
        "AGENT_BROWSER_CONTENT_BOUNDARIES": "1",
        "AGENT_BROWSER_MAX_OUTPUT": "50000",
        "AGENT_BROWSER_NAMESPACE": "cf-tamac",
        "AGENT_BROWSER_SCREENSHOT_DIR": "./test-results/agent-browser"
      }
    },
    "serena": {
      "type": "local",
      "command": ["serena", "start-mcp-server", "--context=ide", "--project", "."],
      "cwd": ".",
      "enabled": true,
      "timeout": 60000
    }
  }
}
